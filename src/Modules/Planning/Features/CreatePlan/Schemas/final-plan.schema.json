{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conclave.local/schemas/final-plan.schema.json",
  "title": "Conclave final plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["goal", "implementationSteps"],
  "properties": {
    "goal": { "type": "string", "minLength": 1 },
    "relevantArchitecture": { "$ref": "#/$defs/strings" }, "invariants": { "$ref": "#/$defs/strings" },
    "architecturalDecisions": { "type": "array", "items": { "$ref": "#/$defs/decision" } },
    "domainChanges": { "$ref": "#/$defs/strings" }, "persistenceChanges": { "$ref": "#/$defs/strings" },
    "apiChanges": { "$ref": "#/$defs/strings" }, "affectedComponents": { "$ref": "#/$defs/strings" },
    "implementationSteps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } },
    "migration": { "$ref": "#/$defs/strings" }, "testing": { "$ref": "#/$defs/strings" },
    "observability": { "$ref": "#/$defs/strings" }, "security": { "$ref": "#/$defs/strings" },
    "risks": { "$ref": "#/$defs/strings" }, "rejectedAlternatives": { "$ref": "#/$defs/strings" },
    "councilDisagreements": { "type": "array", "items": { "$ref": "#/$defs/councilDisagreement" } }, "openQuestions": { "$ref": "#/$defs/strings" },
    "claims": { "type": "array", "items": { "$ref": "#/$defs/claim" } }
  },
  "$defs": {
    "strings": { "type": "array", "items": { "type": "string" } },
    "evidence": { "type": "object", "additionalProperties": false, "required": ["file"], "properties": { "file": { "type": "string", "minLength": 1 }, "symbol": { "type": ["string", "null"] }, "kind": { "type": "string" } } },
    "claim": { "type": "object", "additionalProperties": false, "required": ["id", "kind", "statement"], "properties": { "id": { "type": "string", "minLength": 1 }, "kind": { "enum": ["repository_fact", "architectural_reasoning", "assumption", "external_constraint"] }, "statement": { "type": "string", "minLength": 1 }, "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } } } },
    "decision": { "type": "object", "additionalProperties": false, "required": ["id", "statement"], "properties": { "id": { "type": "string", "minLength": 1 }, "statement": { "type": "string", "minLength": 1 }, "supportedBy": { "type": "array", "description": "IDs of claims or decisions declared in this artifact.", "items": { "type": "string" } } } },
    "councilDisagreement": { "type": "object", "additionalProperties": false, "required": ["summary"], "properties": { "sourceIds": { "type": "array", "description": "Stable IDs from disagreement-catalog.json; every catalog ID must appear exactly once in the final plan.", "items": { "type": "string" } }, "summary": { "type": "string", "minLength": 1, "description": "A concise synthesis or paraphrase of the referenced disagreements." } } },
    "target": { "type": "object", "additionalProperties": false, "required": ["path", "operation"], "properties": { "path": { "type": "string", "minLength": 1 }, "operation": { "enum": ["create", "modify", "delete", "rename", "move", "generated"] }, "destination": { "type": ["string", "null"] } } },
    "step": { "type": "object", "additionalProperties": false, "required": ["id", "targets", "changes", "reason", "tests"], "properties": { "id": { "type": "string", "minLength": 1 }, "targets": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/target" } }, "changes": { "type": "string", "minLength": 1 }, "reason": { "type": "string", "minLength": 1 }, "tests": { "type": "array", "minItems": 1, "items": { "type": "string" } } } }
  }
}
