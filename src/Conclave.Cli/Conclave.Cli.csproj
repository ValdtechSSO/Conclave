<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>conclave</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>conclave</ToolCommandName>
    <PackageId>Conclave.Cli</PackageId>
    <Version>2.3.5</Version>
    <Description>Evidence-backed multi-model implementation planning CLI.</Description>
    <PackageOutputPath>../../artifacts/packages</PackageOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Conclave.Core/Conclave.Core.csproj" />
    <ProjectReference Include="../Conclave.Infrastructure/Conclave.Infrastructure.csproj" />
    <ProjectReference Include="../Conclave.Repository/Conclave.Repository.csproj" />
    <ProjectReference Include="../Conclave.Providers/Conclave.Providers.csproj" />
    <ProjectReference Include="../Conclave.Validation/Conclave.Validation.csproj" />
    <ProjectReference Include="../Conclave.Orchestration/Conclave.Orchestration.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../Conclave.Orchestration/Features/Plan/Schemas/*.json" Link="Features/Plan/Schemas/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../Conclave.Orchestration/Features/Plan/Prompts/*.md" Link="Features/Plan/Prompts/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../config/conclave.default.yaml" Link="config/conclave.default.yaml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../config/deepseek-models.json" Link="config/deepseek-models.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
